# 文字の見やすさ
# 透過（background-opacity = 0.75）すると背景が明るく透けて、細い文字や灰色の文字が薄く見えるため少し濃くする

# 文字の線を太めに描く（macOS のみ。macOS 側のフォントスムージング設定は Ghostty には効かない）
font-thicken = true
# 太さの強さ（0〜255。0 でも「いちばん弱い太らせ方」で、無効にはならない）
# 濃すぎると感じたら下げる。既定は 255
font-thicken-strength = 128

# 薄い文字（SGR 2 / faint）の不透明度。既定は 0.5
faint-opacity = 0.7

# 灰色（パレット 8 = bright black）を少し明るくする。既定は #666666
# git のヒントや zsh の補完候補など、コマンドの補足表示によく使われる色
palette = 8=#8a8a8a
